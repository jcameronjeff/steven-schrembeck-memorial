{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "output/vercel",
  "installCommand": "npm ci",
  "headers": [
    {"source": "/api/(.*)", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
    {"source": "/contribute.html", "headers": [{"key": "Referrer-Policy", "value": "no-referrer"}, {"key": "X-Robots-Tag", "value": "noindex"}]}
  ]
}
